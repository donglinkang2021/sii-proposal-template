% 优先使用原稿字体；在其他电脑上依次尝试 macOS 和 TeX Live 字体。
% 不将商业字体复制进项目。日志会明确记录采用的字体。
\IfFontExistsTF{Times New Roman}
  {\setmainfont{Times New Roman}}
  % 按文件加载 TeX Live 字体，不依赖系统 fontconfig 的字体名称索引。
  {\setmainfont{texgyretermes}[
    Extension=.otf,
    UprightFont=*-regular,
    BoldFont=*-bold,
    ItalicFont=*-italic,
    BoldItalicFont=*-bolditalic]}
\IfFontExistsTF{SimSun}{
  \setCJKmainfont[AutoFakeBold=2.5]{SimSun}
  \setCJKmonofont{SimSun}
  \typeout{SII Song font: SimSun}
}{\IfFontExistsTF{Songti SC}{
  \setCJKmainfont[BoldFont=Songti SC Bold]{Songti SC}
  \setCJKmonofont{Songti SC}
  \typeout{SII Song font: Songti SC (SimSun unavailable)}
}{
  \setCJKmainfont[Extension=.otf,BoldFont=FandolSong-Bold]{FandolSong-Regular}
  \setCJKmonofont[Extension=.otf]{FandolSong-Regular}
  \typeout{SII Song font: FandolSong (SimSun unavailable)}
}}
\IfFontExistsTF{KaiTi}{
  \setCJKfamilyfont{proposal-kai}[AutoFakeBold=2.5]{KaiTi}
}{\IfFontExistsTF{Kaiti SC}{
  \setCJKfamilyfont{proposal-kai}{Kaiti SC}
}{\setCJKfamilyfont{proposal-kai}[Extension=.otf]{FandolKai-Regular}}}
\IfFontExistsTF{FangSong}{
  \setCJKfamilyfont{proposal-fang}{FangSong}
}{\IfFontExistsTF{STFangsong}{
  \setCJKfamilyfont{proposal-fang}{STFangsong}
}{\setCJKfamilyfont{proposal-fang}[Extension=.otf]{FandolFang-Regular}}}
\newcommand{\ProposalKai}{\CJKfamily{proposal-kai}}
