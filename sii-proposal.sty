\AtBeginDocument{\fontsize{12bp}{15.6bp}\selectfont}

\newcommand{\ProposalMode}{all}
\newcommand{\ProposalLayout}{template}
\newif\ifProposalReport
\newcommand{\ProposalType}{}
\newcommand{\StudentName}{}
\newcommand{\StudentID}{}
\newcommand{\AdvisorLeader}{}
\newcommand{\AdvisorMembers}{}
\newcommand{\ProposalTitle}{}
\newcommand{\MajorField}{}
\newcommand{\ProposalYear}{}
\newcommand{\ProposalMonth}{}
\newcommand{\ProposalDay}{}
\newif\ifTemplateBlanks
\TemplateBlankstrue
\AtBeginDocument{
  \ifdefstring{\ProposalLayout}{report}{\ProposalReporttrue}{%
    \ifdefstring{\ProposalLayout}{template}{}{%
      \PackageError{sii-proposal}{Invalid ProposalLayout}{Use template or report.}}}
  \ifboolexpr{test {\ifdefstring{\ProposalMode}{all}} or
              test {\ifdefstring{\ProposalMode}{thesis}} or
              test {\ifdefstring{\ProposalMode}{practice}}}{}
    {\PackageError{sii-proposal}{Invalid ProposalMode}{Use all, thesis, or practice.}}
  \ifboolexpr{test {\ifdefempty{\ProposalType}} or
              test {\ifdefstring{\ProposalType}{thesis}} or
              test {\ifdefstring{\ProposalType}{practice}}}{}
    {\PackageError{sii-proposal}{Invalid ProposalType}{Use an empty value, thesis, or practice.}}
  \ifProposalReport
    \ifdefstring{\ProposalMode}{all}{%
      \PackageError{sii-proposal}{Report layout requires one proposal type}{Set ProposalMode to thesis or practice; all is only for template layout.}}{}
    \ifdefempty{\ProposalType}{\let\ProposalType\ProposalMode}{%
      \ifdefstrequal{\ProposalType}{\ProposalMode}{}{%
        \PackageError{sii-proposal}{ProposalType conflicts with ProposalMode}{In report layout, leave ProposalType empty or make it match ProposalMode.}}}
    \TemplateBlanksfalse
    \ProposalReportStyle
  \fi
  \hypersetup{pdftitle={上海创智学院博士研究生开题报告},pdfauthor={\StudentName}}
}

% 正式版独立启用；不改变原始表单的字体、分页或页式。
\newcommand{\ProposalReportStyle}{%
  \IfFontExistsTF{SimHei}{%
    \setCJKfamilyfont{proposal-hei}{SimHei}%
    \typeout{SII heading font: SimHei}%
  }{\IfFontExistsTF{Heiti SC}{%
    \setCJKfamilyfont{proposal-hei}{Heiti SC}%
    \typeout{SII heading font: Heiti SC}%
  }{\setCJKfamilyfont{proposal-hei}[Extension=.otf]{FandolHei-Regular}%
    \typeout{SII heading font: FandolHei-Regular}}}%
  % 重设 normalsize，保证目录、表格等分组结束后仍恢复 20 bp 行距。
  \renewcommand{\normalsize}{%
    \@setfontsize\normalsize{12bp}{20bp}%
    \setlength{\abovedisplayskip}{10bp}%
    \setlength{\belowdisplayskip}{10bp}%
    \setlength{\abovedisplayshortskip}{6bp}%
    \setlength{\belowdisplayshortskip}{6bp}}%
  \normalsize
  \setlength{\parindent}{2em}\setlength{\parskip}{0pt}%
  \raggedbottom
  \clubpenalty=10000 \@clubpenalty=10000 \widowpenalty=10000
  \setcounter{tocdepth}{2}\setcounter{secnumdepth}{3}%
  % ctex 的 break 键会在连续空标题之间被跳过；入口处清页也覆盖未填正文的章。
  \AddToHook{cmd/section/before}{\clearpage\@nobreakfalse}%
  % number 仅影响显示；thesection 和交叉引用仍为阿拉伯数字。
  \ctexset{
    section={format=\normalfont\ProposalHei\fontsize{16bp}{24bp}\selectfont\centering,
      name={第,章},number=\arabic{section},aftername=\quad,
      break={},beforeskip=6bp,afterskip=18bp,hang=false},
    subsection={format=\normalfont\ProposalHei\fontsize{14bp}{20bp}\selectfont\raggedright,
      number=\arabic{section}.\arabic{subsection},aftername=\quad,
      beforeskip=24bp,afterskip=8bp},
    subsubsection={format=\normalfont\ProposalHei\fontsize{12bp}{18bp}\selectfont\raggedright,
      number=\arabic{section}.\arabic{subsection}.\arabic{subsubsection},aftername=\quad,
      beforeskip=16bp,afterskip=6bp}}%
  \setlength{\headheight}{14bp}\setlength{\headsep}{6mm}%
  \setlength{\footskip}{10mm}%
  \fancypagestyle{proposalreport}{%
    \fancyhf{}%
    \fancyhead[C]{\normalfont\fontsize{9bp}{12bp}\selectfont 上海创智学院博士研究生开题报告}%
    \fancyfoot[C]{\normalfont\fontsize{10.5bp}{14bp}\selectfont\thepage}%
    \renewcommand{\headrulewidth}{.4pt}%
    \renewcommand{\footrulewidth}{0pt}}%
  \pagestyle{proposalreport}%
  \titlecontents{section}[4em]
    {\addvspace{6bp}\normalfont\ProposalHei\fontsize{12bp}{18bp}\selectfont}
    {\contentslabel{4em}}{\hspace*{-4em}}
    {\titlerule*[.5em]{.}\contentspage}%
  \titlecontents{subsection}[5em]
    {\normalfont\fontsize{12bp}{18bp}\selectfont}
    {\contentslabel{3em}}{\hspace*{-3em}}
    {\titlerule*[.5em]{.}\contentspage}%
  \contentsmargin{2.5em}%
  \DeclareCaptionFont{proposalcaption}{\normalfont\fontsize{11bp}{15bp}\selectfont}%
  \DeclareCaptionFont{proposalsubcaption}{\normalfont\fontsize{10.5bp}{14bp}\selectfont}%
  \DeclareCaptionLabelSeparator{proposalspace}{\quad}%
  \captionsetup{font=proposalcaption,labelsep=proposalspace,skip=6bp}%
  \captionsetup*[figure]{position=bottom}%
  \captionsetup*[table]{position=top}%
  \captionsetup*[sub]{font=proposalsubcaption}%
  \setlength{\textfloatsep}{12bp plus 2bp minus 2bp}%
  \setlength{\intextsep}{12bp plus 2bp minus 2bp}%
  \setlength{\floatsep}{10bp plus 2bp minus 2bp}%
  \renewcommand{\bibfont}{\normalfont\fontsize{10.5bp}{15bp}\selectfont}%
  \setlength{\bibitemsep}{4bp}\setlength{\bibparsep}{0pt}%
}
\AtBeginEnvironment{table}{\ifProposalReport
  \fontsize{11bp}{16bp}\selectfont\renewcommand{\arraystretch}{1.1}\fi}
\AtBeginEnvironment{table*}{\ifProposalReport
  \fontsize{11bp}{16bp}\selectfont\renewcommand{\arraystretch}{1.1}\fi}

% 用矢量线条绘制勾选框，不依赖 Wingdings 等符号字体。
\newcommand{\ProposalCheck}[1]{%
  \tikz[baseline=-0.5mm,x=1mm,y=1mm]{%
    \draw[line width=.4pt] (0,0) rectangle (2.8,2.8);
    \ifdefstring{\ProposalType}{#1}{%
      \draw[line width=.65pt] (.45,1.4)--(1.15,.55)--(2.4,2.25);
    }{}%
  }\kern.12em}
\newcommand{\CoverField}[1]{\rule[-3.5mm]{0pt}{9.2mm}#1}
% 与封面勾选使用同一类型；未选择类型时保留原始通用表单。
\newcommand{\ProposalCoverTitleLabel}{%
  \ifdefstring{\ProposalType}{thesis}{论文题目}{%
    \ifdefstring{\ProposalType}{practice}{实践成果名称}{论文题目/实践成果名称}}}
\newlength{\ProposalCoverLabelWidth}
\newlength{\ProposalCoverFieldWidth}
\newcommand{\ProposalSetupCoverFields}{%
  \setlength{\ProposalCoverLabelWidth}{4.95cm}%
  \setlength{\ProposalCoverFieldWidth}{8.25cm}%
  \ifdefempty{\ProposalType}{}{%
    \setlength{\ProposalCoverLabelWidth}{3cm}%
    % cline 另含 1.5 mm 列内留白，实际横线约 9.5 cm，与参考模板接近。
    \setlength{\ProposalCoverFieldWidth}{9.35cm}}}
\newcommand{\makeproposalcover}{%
  \ProposalSetupCoverFields
  \ifProposalReport\makeproposalreportcover\else\makeproposaltemplatecover\fi}
\newcommand{\makeproposaltemplatecover}{%
  \begin{titlepage}
  \centering
  \setlength{\parindent}{0pt}
  \vspace*{-\topskip}
  \includegraphics[width=5.5cm,height=5.5cm,keepaspectratio]{figures/sii_logo.pdf}\par
  \nointerlineskip
  \vspace{4.5mm}
  {\fontsize{24bp}{32bp}\selectfont\bfseries
    上海创智学院\par
    \vspace{1mm}
    博士研究生开题报告\par}
  \vspace{10mm}
  {\ProposalKai\fontsize{12bp}{15.6bp}\selectfont
  \setlength{\tabcolsep}{1.5mm}
  \setlength{\arrayrulewidth}{.5pt}
  \begin{tabular}{@{}>{\raggedright\arraybackslash}m{\ProposalCoverLabelWidth}
                       >{\raggedright\arraybackslash}m{\ProposalCoverFieldWidth}@{}}
    姓名 & \CoverField{\StudentName}\\\cline{2-2}
    学号 & \CoverField{\StudentID}\\\cline{2-2}
    开题类型 & \CoverField{\ProposalCheck{thesis}学位论文\quad
                          \ProposalCheck{practice}实践成果}\\\cline{2-2}
    导师组 & \CoverField{组长：\AdvisorLeader}\par
              \CoverField{组员：\AdvisorMembers}\\\cline{2-2}
    \ProposalCoverTitleLabel & \CoverField{\ProposalTitle}\\\cline{2-2}
    专业/领域 & \CoverField{\MajorField}\\\cline{2-2}
  \end{tabular}\par
  \vspace{27mm}
  \ProposalYear 年\quad\ProposalMonth 月\quad\ProposalDay 日\par}
  \end{titlepage}
}

\newcommand{\ProposalReportCoverField}[1]{\rule[-3.5mm]{0pt}{10.5mm}#1}
\newcommand{\makeproposalreportcover}{%
  \begin{titlepage}
  \centering\setlength{\parindent}{0pt}%
  \vspace*{-\topskip}%
  \includegraphics[width=5.5cm,height=5.5cm,keepaspectratio]{figures/sii_logo.pdf}\par
  \nointerlineskip\vspace{4.5mm}%
  {\fontsize{26bp}{36bp}\selectfont\bfseries
    上海创智学院\par\vspace{1mm}博士研究生开题报告\par}%
  \vspace{10mm}%
  {\ProposalKai\fontsize{13bp}{18bp}\selectfont
    \setlength{\tabcolsep}{1.5mm}\setlength{\arrayrulewidth}{.5pt}%
    \begin{tabular}{@{}>{\raggedright\arraybackslash}m{\ProposalCoverLabelWidth}
                         >{\centering\arraybackslash}m{\ProposalCoverFieldWidth}@{}}
      姓名 & \ProposalReportCoverField{\StudentName}\\\cline{2-2}
      学号 & \ProposalReportCoverField{\StudentID}\\\cline{2-2}
      开题类型 & \ProposalReportCoverField{\ProposalCheck{thesis}学位论文\quad
                                            \ProposalCheck{practice}实践成果}\\\cline{2-2}
      导师组 & {\raggedright
        \ProposalReportCoverField{组长：\AdvisorLeader}\par
        \ProposalReportCoverField{组员：\AdvisorMembers}\par}\\\cline{2-2}
      \ProposalCoverTitleLabel & \ProposalReportCoverField{\ProposalTitle}\\\cline{2-2}
      专业/领域 & \ProposalReportCoverField{\MajorField}\\\cline{2-2}
    \end{tabular}\par
    \vspace{25mm}%
    \ProposalYear 年\quad\ProposalMonth 月\quad\ProposalDay 日\par}%
  \end{titlepage}
}

% breakable 保留原稿的单线外框，正文增长时可自然跨页。
\newtcolorbox{proposalframe}{enhanced,breakable,sharp corners,
  colback=white,colframe=black,boxrule=.5pt,
  left=1.5mm,right=1.5mm,top=1mm,bottom=2mm,boxsep=0pt,
  before upper={\setlength{\parindent}{2em}},
  before skip=0pt,after skip=0pt,
  pad at break*=2mm}
\newcounter{proposaloutline}
\newenvironment{proposalbody}{%
  \setcounter{proposaloutline}{0}\setcounter{section}{0}%
  \ifProposalReport\let\ProposalBodyStart\relax\let\ProposalBodyEnd\par
  \else\def\ProposalBodyStart{\begin{proposalframe}}%
       \def\ProposalBodyEnd{\end{proposalframe}}\fi
  \ProposalBodyStart
}{\ProposalBodyEnd}
\newcommand{\ProposalBodyIntro}[1]{\ifProposalReport\else
  \noindent\textbf{#1}开题报告应包括但不限于：\par\fi}
\newcommand{\ProposalTemplateHeading}[2]{%
  \par\addvspace{2.75mm}\needspace{2\baselineskip}%
  \noindent #1.\enspace #2\par\nobreak
}
\newcommand{\ProposalSection}[1]{%
  \ifProposalReport\section{#1}\else
    \refstepcounter{proposaloutline}%
    \ProposalTemplateHeading{\arabic{proposaloutline}}{#1}\fi}
% 兼容旧的显式编号入口；后续 ProposalSection 从该编号继续。
\newcommand{\ProposalHeading}[2]{%
  \ifProposalReport\setcounter{section}{\numexpr#1-1\relax}\section{#2}%
  \else\setcounter{proposaloutline}{\numexpr#1-1\relax}%
    \ProposalSection{#2}\fi}
\newcommand{\WritingSpace}{%
  \ifProposalReport\else
    \ifTemplateBlanks\vspace{16mm}\else\vspace{1mm}\fi\fi
}

% 每行单独排版，允许在行之间分页，避免把整张进度表锁定在同一页。
% 单行内部自动换行；极长阶段请拆成多行。
\newenvironment{proposaltemplateschedule}{%
  \par\begingroup\setlength{\parindent}{0pt}\setlength{\parskip}{0pt}%
  \setlength{\tabcolsep}{2mm}%
  \noindent\begin{tabularx}{\linewidth}{|>{\centering\arraybackslash}p{.22\linewidth}|
    >{\centering\arraybackslash}X|>{\centering\arraybackslash}p{.43\linewidth}|}
    \hline
    \rule[-2mm]{0pt}{7.5mm}起讫时间 & 主要研究内容 & 预期结果、阶段性成果\\\hline
  \end{tabularx}\par\nobreak\nointerlineskip
}{\par\endgroup}
\newcommand{\ProposalTemplateRow}[3]{%
  \noindent\begin{tabularx}{\linewidth}{|>{\raggedright\arraybackslash}p{.22\linewidth}|
    >{\raggedright\arraybackslash}X|>{\raggedright\arraybackslash}p{.43\linewidth}|}
    \rule[-2mm]{0pt}{7.5mm}#1 & #2 & #3\\\hline
  \end{tabularx}\par\penalty0\nointerlineskip
}
\newcommand{\ProposalReportRow}[3]{%
  \rule[-2mm]{0pt}{7.5mm}#1 & #2 & #3\\\hline}
\newcommand{\ProposalScheduleHead}{%
  \rule[-2mm]{0pt}{7.5mm}\ProposalHei 起讫时间 &
  \ProposalHei 主要研究内容 & \ProposalHei 预期结果、阶段性成果\\\hline}
\newcounter{proposalprogress}
\newlength{\ProposalScheduleWidth}
\newenvironment{proposalreportschedule}{%
  \par\fontsize{11bp}{16bp}\selectfont\setlength{\tabcolsep}{2mm}%
  \renewcommand{\arraystretch}{1.1}%
  \setlength{\LTpre}{12bp}\setlength{\LTpost}{12bp}%
  \setlength{\ProposalScheduleWidth}{\dimexpr\linewidth-6\tabcolsep-4\arrayrulewidth\relax}%
  % 进度表没有题注，不占用正文中有编号表格的序号。
  \renewcommand{\LTcaptype}{proposalprogress}%
  \begin{longtable}{|>{\raggedright\arraybackslash}p{.18\ProposalScheduleWidth}|
    >{\raggedright\arraybackslash}p{.34\ProposalScheduleWidth}|
    >{\raggedright\arraybackslash}p{.48\ProposalScheduleWidth}|}
    \hline\ProposalScheduleHead\endfirsthead
    \hline\ProposalScheduleHead\endhead
    \endfoot\endlastfoot
}{\end{longtable}}
\newcommand{\ScheduleRow}[3]{\ProposalTemplateRow{#1}{#2}{#3}}
\newenvironment{proposalschedule}{%
  \ifProposalReport
    \let\ScheduleRow\ProposalReportRow
    \def\ProposalScheduleStart{\begin{proposalreportschedule}}%
    \def\ProposalScheduleEnd{\end{proposalreportschedule}}%
  \else
    \let\ScheduleRow\ProposalTemplateRow
    \def\ProposalScheduleStart{\begin{proposaltemplateschedule}}%
    \def\ProposalScheduleEnd{\end{proposaltemplateschedule}}%
  \fi\ProposalScheduleStart
}{\ProposalScheduleEnd}

\newcommand{\makeproposalcontents}{%
  \ifProposalReport
    \clearpage\pagestyle{proposalreport}\pagenumbering{Roman}%
    \tableofcontents\clearpage\pagenumbering{arabic}%
  \fi}
\newcommand{\printproposalbibliography}{%
  \ifProposalBibliography
    \clearpage
    \ifProposalReport
      \printbibliography[heading=bibintoc,title={参考文献}]%
    \else\printbibliography[title={参考文献}]\fi
  \fi}
